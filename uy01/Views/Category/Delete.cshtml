@model CategoryModel

<div class="row">
	<div class="col-md-4">
		<div class="card">
			<div class="card-header"><h3>Kategori Sil</h3></div>
			<div class="card-body">
				<form asp-action="Delete" method="post">

					<div class="alert alert-danger">@Model.Name adlı kategori silinecektir Onaylıyor musunuz?
			
					</div>
					
					<div class="mb-3">
						<input asp-for="Id" type="hidden" />
						<input type="submit" value="Evet, Sil" class="btn btn-outline-danger" />
						<a asp-action="Index" class="btn btn-outline-secondary">Hayır, Vazgeç</a>
					</div>

				</form>


			</div>
		</div>
	</div>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}