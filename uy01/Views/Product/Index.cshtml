@model List<ProductModel>




<div class="row">
	<div class="col-md-12">

		<div class="card">
			<div class="card-header"><h3>Ürünler</h3></div>
			<div class="card-body">

				<a asp-controller="Product" asp-action="Add" class="btn btn-outline-primary mb-3">Ekle</a>
				<table class="table table-hover">
					<thead>
						<tr>
							<th>Id</th>
							<th>Adı</th>
							<th>Fiyatı</th>
							<th>Durumu</th>
							<td>Düzenle - Sil</td>

						</tr>
					</thead>
					<tbody>
						@foreach (var product in Model)
						{
							<tr>
								<td>@product.Id</td>
								<td>@product.Name</td>
								<td>@product.Price</td>
								<td>
									@if (product.IsActive)
									{
										<span class="badge bg-success text-white">Aktif</span>
									}
									else
									{
										<span class="badge bg-danger text-white">Pasif</span>
									}
								</td>
								<td>
									<a class="btn btn-outline-primary" asp-controller="Product" asp-action="Update" asp-route-id="@product.Id">Düzenle</a>
									<a class=" btn btn-outline-danger" asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id">Sil</a>
								</td>
							</tr>
						}
					</tbody>

				</table>

			</div>
			<div class="card-footer">

				Toplam Ürün Sayısı : @Model.Count

			</div>
		</div>







	</div>
</div>


