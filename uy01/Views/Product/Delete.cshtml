
@model ProductModel



<div class="row">
	<div class="col-md-4">

		<div class="card">
			<div class="card-header"><h3>Ürün Sil</h3></div>
			<div class="card-body">
				<div class="alert alert-danger">@Model.Name adlı ürün silinecektir onaylıyor musunuz?</div>

				<form asp-action="Delete">
					<input type="hidden" asp-for="Id" />
					<input type="submit" class="btn btn-outline-danger" value="Sil" />
					<a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
				</form>

			</div>
		</div>



		
	</div>
</div>


